[Unit]
Description=Mezamashi Discord Bot (目覚ましBot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ↓ 自分の環境に合わせて書き換える（ユーザー名とリポジトリの絶対パス）
WorkingDirectory=/home/ubuntu/mezamashi-bot-v2
EnvironmentFile=/home/ubuntu/mezamashi-bot-v2/.env
ExecStart=/home/ubuntu/mezamashi-bot-v2/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
